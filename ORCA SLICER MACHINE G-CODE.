ORCA SLICER MACHINE G-CODE.

#Start code

PRINT_START BED=[bed_temperature_initial_layer_single] HOTEND=[nozzle_temperature_initial_layer] CHAMBER=[chamber_temperature] EXTRUDER=[initial_no_support_extruder]
SET_PRINT_STATS_INFO TOTAL_LAYER=[total_layer_count]
M83
T[initial_tool]
M140 S[bed_temperature_initial_layer_single]
M104 S[nozzle_temperature_initial_layer]
M141 S[chamber_temperature]
G4 P3000
G1 X108 Y1 F30000
G1 Z1 F600
#end of custom start code

#------------------
#END code
#------------------
SET_PRINT_MAIN_STATUS MAIN_STATUS=print_end
DISABLE_BOX_HEATER
M141 S0
M140 S0
BUFFER_MONITORING ENABLE=0
DISABLE_ALL_SENSOR
G1 E-3 F1800
{if max_layer_z + 3 > max_print_height}
G0 Z{max_print_height} F600
{else}
G0 Z{max_layer_z + 3} F600
{endif}
UNLOAD_FILAMENT T=[current_extruder]
G0 Y270 F12000
G0 X90 Y270 F12000
{if max_layer_z < max_print_height / 2}G1 Z{max_print_height / 2 + 10} F600{else}G1 Z{min(max_print_height, max_layer_z + 3)}{endif}
M104 S0
PRINT_END
#end of custom finish code.


#-------------------
#LAYER CHANGE G-CODE
#--------------------
SET_PRINT_STATS_INFO CURRENT_LAYER={layer_num + 1}
SET_CURRENT_LAYER LAYER={layer_num + 1}
_CHECK_LAYER_PAUSE
{if timelapse_type == 1} ; timelapse with wipe tower
G92 E0
G1 E-[retraction_length] F1800
{if layer_z + 0.4 > max_print_height}
G2 Z{max_print_height} I0.86 J0.86 P1 F20000 ; spiral lift a little
{else}
G2 Z{layer_z + 0.4} I0.86 J0.86 P1 F20000 ; spiral lift a little
{endif}
G1 Y235 F20000
G1 X97 F20000
{if layer_z <=25}
G1 Z25
{endif}
G1 Y254 F2000
G92 E0
M400
TIMELAPSE_TAKE_FRAME
G1 E[retraction_length] F300
G1 X85 F2000
G1 X97 F2000
G1 Y220 F2000
{if layer_z <=25}
G1 Z[layer_z]
{endif}
{elsif timelapse_type == 0} ; timelapse without wipe tower
TIMELAPSE_TAKE_FRAME
{endif}
G92 E0
#end of layer change g-code

#-----------------------
#CHANGE FILAMENT G-CODE
#-----------------------
{if max_layer_z + 3 > max_print_height}
G0 Z{max_print_height} F1200
{else}
G1 Z{max_layer_z + 3.0} F1200
{endif}
TOOL_CHANGE_START F=[current_extruder] T=[next_extruder]
BUFFER_MONITORING ENABLE=0
DISABLE_ALL_SENSOR
M106 S255
MOVE_TO_TRASH
{if long_retractions_when_cut[previous_extruder]}
G1 E-{retraction_distances_when_cut[previous_extruder]} F{old_filament_e_feedrate}
{else}
G1 E-10 F{old_filament_e_feedrate}
{endif}
M400
CUT_FILAMENT T=[current_extruder]
MOVE_TO_TRASH
M106 P2 S0
UNLOAD_T[current_extruder]
T[next_extruder]
{if nozzle_temperature_range_high[current_extruder] >= nozzle_temperature_range_high[next_extruder]}
M104 S{nozzle_temperature_range_high[current_extruder]}
{else}
M104 S{nozzle_temperature_range_high[next_extruder]}
{endif}
; FLUSH_START
M106 S25
G1 E30 F300
; FLUSH_END
{if long_retractions_when_cut[previous_extruder]}
G1 E{retraction_distances_when_cut[previous_extruder]} F{old_filament_e_feedrate}
{endif}
{if flush_length_1 > 1}
; FLUSH_START
{if flush_length_1 > 23.7}
G1 E23.7 F{old_filament_e_feedrate}
G1 E{(flush_length_1 - 23.7) * 0.02} F50
G1 E{(flush_length_1 - 23.7) * 0.23} F{old_filament_e_feedrate}
G1 E{(flush_length_1 - 23.7) * 0.02} F50
G1 E{(flush_length_1 - 23.7) * 0.23} F{new_filament_e_feedrate}
G1 E{(flush_length_1 - 23.7) * 0.02} F50
G1 E{(flush_length_1 - 23.7) * 0.23} F{new_filament_e_feedrate}
G1 E{(flush_length_1 - 23.7) * 0.02} F50
G1 E{(flush_length_1 - 23.7) * 0.23} F{new_filament_e_feedrate}
{else}
G1 E{flush_length_1} F{old_filament_e_feedrate}
{endif}
G1 E-[old_retract_length_toolchange] F1800
; FLUSH_END
{endif}
{if flush_length_2 > 1}
; FLUSH_START
G1 X92 F9000
G1 E[old_retract_length_toolchange] F300
G1 E{flush_length_2 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_2 * 0.02} F50
G1 E{flush_length_2 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_2 * 0.02} F50
G1 E{flush_length_2 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_2 * 0.02} F50
G1 E{flush_length_2 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_2 * 0.02} F50
G1 E{flush_length_2 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_2 * 0.02} F50
G1 E-[new_retract_length_toolchange] F1800
; FLUSH_END
{endif}
{if flush_length_3 > 1}
; FLUSH_START
G1 X85 F9000
G1 E[new_retract_length_toolchange] F300
G1 E{flush_length_3 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_3 * 0.02} F50
G1 E{flush_length_3 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_3 * 0.02} F50
G1 E{flush_length_3 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_3 * 0.02} F50
G1 E{flush_length_3 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_3 * 0.02} F50
G1 E{flush_length_3 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_3 * 0.02} F50
G1 E-[new_retract_length_toolchange] F1800
; FLUSH_END
{endif}
{if flush_length_4 > 1}
; FLUSH_START
G1 X92 F9000
G1 E[new_retract_length_toolchange] F300
G1 E{flush_length_4 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_4 * 0.02} F50
G1 E{flush_length_4 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_4 * 0.02} F50
G1 E{flush_length_4 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_4 * 0.02} F50
G1 E{flush_length_4 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_4 * 0.02} F50
G1 E{flush_length_4 * 0.18} F{new_filament_e_feedrate}
G1 E{flush_length_4 * 0.02} F50
G1 E-[new_retract_length_toolchange] F1800
; FLUSH_END
{endif}
M400
M106 S255
M104 S[new_filament_temp]
INIT_SYNC_BUFFER_STATE
BUFFER_MONITORING ENABLE=1
G1 E10 F25
M109 S[new_filament_temp]
G1 E-5 F1800
CLEAR_OOZE
TOOL_CHANGE_END
G1 Y270 F8000
M106 S0
G1 E2 F1800
ENABLE_ALL_SENSOR
#end of change filament g-code

#pause g-code
PAUSE
#END OF PAUSE G-CODE

